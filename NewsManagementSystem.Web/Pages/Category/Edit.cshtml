@page "{id:int}"
@model NewsManagementSystem.Web.Pages.Category.EditModel
@{
    ViewData["Title"] = "Edit Category";
    Layout = "_LayoutStaff";
    var user = ViewData["UserInfo"] as NewsManagementSystem.BusinessObject.Configuration.LoginDTO;
}
<style>
    label, button, select {
        color: black;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 5px;
        margin-right: 10px;
        cursor: pointer;
    }

    .form-check-label {
        font-weight: 500;
        color: black;
        cursor: pointer;
        font-size: 16px;
        padding-left: 20px;
    }

    .custom-margin-top {
        margin-top: 25px;
    }
</style>

<div class="container mt-5">
    @Html.AntiForgeryToken()
    <h2 class="text-primary mb-4">✏️ Edit Category</h2>

    <form method="post" id="editCategoryForm" asp-page="Edit">
        <input asp-for="Category.CategoryId" type="hidden" />

        <div class="bg-white p-4 shadow rounded">
            <div class="form-group mb-3">
                <label asp-for="Category.CategoryName" class="form-label"></label>
                <input asp-for="Category.CategoryName" class="form-control" />
                <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.CategoryDesciption" class="form-label"></label>
                <textarea asp-for="Category.CategoryDesciption" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Category.CategoryDesciption" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.ParentCategoryId" class="form-label">Parent Category</label>
                <select asp-for="Category.ParentCategoryId" asp-items="Model.ParentCategories" class="form-control">
                    <option value="">-- None --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Is Active</label>
                <div class="form-check">
                    <input type="radio" name="Category.IsActive" value="true" class="form-check-input"
                    @(Model.Category.IsActive == true ? "checked" : "") />
                    <label class="form-check-label">Yes</label>
                </div>
                <div class="form-check">
                    <input type="radio" name="Category.IsActive" value="false" class="form-check-input"
                    @(Model.Category.IsActive == false ? "checked" : "") />
                    <label class="form-check-label">No</label>
                </div>
                <span asp-validation-for="Category.IsActive" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary ms-2" data-bs-dismiss="modal">Cancel</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
