@page
@model NewsManagementSystem.Web.Pages.Category.CreateModel
@{
    ViewData["Title"] = "Create Category";
    Layout = "_Layout";
    var user = ViewData["UserInfo"] as NewsManagementSystem.BusinessObject.Configuration.LoginDTO;
}
<style>
    label, button, select {
        color: black;
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 5px;
        margin-right: 10px;
        cursor: pointer;
    }

    .form-check-label {
        font-weight: 500;
        color: black;
        cursor: pointer;
        font-size: 16px;
        padding-left: 5px;
        margin-right: 20px;
    }

    .custom-margin-top {
        margin-top: 25px;
    }
</style>

<div class="container mt-5">
    <h2 class="text-primary mb-4">➕ Create New Category</h2>

    <form method="post">
        <div class="bg-white p-4 shadow rounded">
            <div class="form-group mb-3">
                <label asp-for="Category.CategoryName" class="form-label"></label>
                <input asp-for="Category.CategoryName" class="form-control" />
                <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.CategoryDesciption" class="form-label"></label>
                <textarea asp-for="Category.CategoryDesciption" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Category.CategoryDesciption" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category.ParentCategoryId" class="form-label">Parent Category</label>
                <select asp-for="Category.ParentCategoryId" asp-items="Model.ParentCategories" class="form-control">
                    <option value="">-- None --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Is Active</label><br />
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="Category.IsActive" class="form-check-input" value="true" checked="@(Model.Category.IsActive == true)" />
                    <label class="form-check-label" for="IsActive">Yes</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" asp-for="Category.IsActive" class="form-check-input" value="false" checked="@(Model.Category.IsActive == false)" />
                    <label class="form-check-label" for="IsActive">No</label>
                </div>
                <span asp-validation-for="Category.IsActive" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary ms-2 custom-margin-top">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
