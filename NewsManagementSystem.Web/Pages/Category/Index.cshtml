@page
@model NewsManagementSystem.Web.Pages.Category.CategoryIndexModel
@{
    ViewData["Title"] = "Category List";
    Layout = "_LayoutStaff";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">📁 Category List</h2>
        <button type="button" class="btn btn-primary" id="btnShowCreateModal">➕ Add New Category</button>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered table-hover bg-white shadow-sm">
        <thead class="table-primary text-center">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Parent</th>
                <th>Active</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody id="categoryList">
            @foreach (var item in Model.Categories)
            {
                <tr class="text-center" id="category-@item.CategoryId">
                    <td class="cat-name">@item.CategoryName</td>
                    <td class="cat-desc">@item.CategoryDesciption</td>
                    <td>@(item.ParentCategory != null ? item.ParentCategory.CategoryName : "-")</td>
                    <td class="cat-active">@(item.IsActive == true ? "Yes" : "No")</td>
                    <td>
                        <a href="javascript:void(0);" class="btn btn-info btn-sm btnShowDetailsModal" data-id="@item.CategoryId">View</a>
                        <a href="javascript:void(0);" class="btn btn-warning btn-sm btnShowEditModal" data-id="@item.CategoryId">Edit</a>
                        <a href="javascript:void(0);" class="btn btn-danger btn-sm btnShowDeleteModal" data-id="@item.CategoryId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->s
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="createCategoryModalBody">
                <!-- The form will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCategoryModalLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editCategoryModalBody">
                <!-- The edit form will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteCategoryModalLabel">Delete Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="deleteCategoryModalBody">
                <!-- The delete confirmation will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsCategoryModal" tabindex="-1" aria-labelledby="detailsCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsCategoryModalLabel">Category Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsCategoryModalBody">
                <!-- The details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/dataHub")
            .build();

        connection.on("CategoryChanged", category => {
            updateCategoryList(category);
        });

        connection.start().catch(err => console.error(err));

        function updateCategoryList(category) {
            const list = document.getElementById("categoryList");

            if (category.action === "created") {
                const newRow = document.createElement("tr");
                newRow.setAttribute("id", `category-${category.id}`);
                newRow.classList.add("text-center");
                newRow.innerHTML = `
                    <td class="cat-name">${category.name}</td>
                    <td class="cat-desc">${category.description}</td>
                    <td>${category.parentName || "-"}</td>
                    <td class="cat-active">${category.isActive ? "Yes" : "No"}</td>
                    <td>
                        <a href="/Category/Details?id=${category.id}" class="btn btn-info btn-sm">View</a>
                        <a href="/Category/Edit?id=${category.id}" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/Category/Delete?id=${category.id}" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                `;
                list.appendChild(newRow);
            }

            if (category.action === "deleted") {
                const row = document.getElementById(`category-${category.id}`);
                if (row) row.remove();
            }

            if (category.action === "updated") {
                const row = document.getElementById(`category-${category.id}`);
                if (row) {
                    row.querySelector(".cat-name").innerText = category.name;
                    row.querySelector(".cat-desc").innerText = category.description;
                    row.querySelector(".cat-active").innerText = category.isActive ? "Yes" : "No";
                }
            }
        }
        document.getElementById('btnShowCreateModal').addEventListener('click', function () {
            fetch('@Url.Page("Create")')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('createCategoryModalBody').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('createCategoryModal'));
                    modal.show();
                });
        });

        // Optional: handle form submission via AJAX for a smoother UX
                        document.addEventListener('submit', function (e) {
            if (e.target && e.target.id === 'createCategoryForm') {
                e.preventDefault();
                const form = e.target;
                const data = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: data
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        bootstrap.Modal.getInstance(document.getElementById('createCategoryModal')).hide();

                    }
                })
                .catch(err => console.error(err));
            }
        });

                // Show Edit Modal and load form
        document.addEventListener('click', function (e) {
            if (e.target && e.target.classList.contains('btnShowEditModal')) {
                const categoryId = e.target.getAttribute('data-id');
                fetch(`/Category/Edit/${categoryId}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('editCategoryModalBody').innerHTML = html;
                        var modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
                        modal.show();
                    });
            }
        });

        // Handle Edit form submission via AJAX
        document.addEventListener('submit', function (e) {
            if (e.target && e.target.id === 'editCategoryForm') {
                e.preventDefault();
                const form = e.target;
                const data = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: data
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editCategoryModal')).hide();
                        // Optionally, update the row in the table or reload the page/list
                    } else if (result.html) {
                        // If validation fails, re-render the form
                        document.getElementById('editCategoryModalBody').innerHTML = result.html;
                    }
                })
                .catch(err => console.error(err));
            }
        });

                // Show Delete Modal and load confirmation
        document.addEventListener('click', function (e) {
            if (e.target && e.target.classList.contains('btnShowDeleteModal')) {
                const categoryId = e.target.getAttribute('data-id');
                fetch(`/Category/Delete/${categoryId}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('deleteCategoryModalBody').innerHTML = html;
                        var modal = new bootstrap.Modal(document.getElementById('deleteCategoryModal'));
                        modal.show();
                    });
            }
        });

        // Handle Delete form submission via AJAX
        document.addEventListener('submit', function (e) {
            if (e.target && e.target.id === 'deleteCategoryForm') {
                e.preventDefault();
                const form = e.target;
                const data = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: data
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        bootstrap.Modal.getInstance(document.getElementById('deleteCategoryModal')).hide();
                        // Optionally, remove the row from the table
                        const row = document.getElementById(`category-${result.id}`);
                        if (row) row.remove();
                    } else if (result.html) {
                        document.getElementById('deleteCategoryModalBody').innerHTML = result.html;
                    }
                })
                .catch(err => console.error(err));
            }
        });

                // Show Details Modal and load details
        document.addEventListener('click', function (e) {
            if (e.target && e.target.classList.contains('btnShowDetailsModal')) {
                const categoryId = e.target.getAttribute('data-id');
                fetch(`/Category/Details/${categoryId}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('detailsCategoryModalBody').innerHTML = html;
                        var modal = new bootstrap.Modal(document.getElementById('detailsCategoryModal'));
                        modal.show();
                    });
            }
        });
    </script>
}
