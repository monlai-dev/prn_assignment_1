@page "{id:int}"
@model NewsManagementSystem.Web.Pages.Category.DetailsModel
@{
    ViewData["Title"] = "Category Details";
    Layout = "_LayoutStaff";
    var user = ViewData["UserInfo"] as NewsManagementSystem.BusinessObject.Configuration.LoginDTO;
}
<style>
    .col-sm-3 {
        color: black;
    }

    .col-sm-9 {
        color: black;
    }
</style>

<div class="container mt-5">
    <h2 class="text-primary mb-4">📄 Category Details</h2>

    <div class="bg-white p-4 shadow rounded">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Category.CategoryName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Category.CategoryDesciption</dd>

            <dt class="col-sm-3">Parent Category</dt>
            <dd class="col-sm-9">@Model.Category.ParentCategory?.CategoryName ?? "None"</dd>

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@((Model.Category.IsActive == true) ? "Yes" : "No")</dd>
        </dl>

        <a asp-page="Index" class="btn btn-secondary ms-2">Back to List</a>
    </div>
</div>
