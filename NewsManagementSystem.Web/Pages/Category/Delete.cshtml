@page "{id:int}"
@model NewsManagementSystem.Web.Pages.Category.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-danger mb-4">🗑️ Delete Category</h2>

    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this category?</strong><br />
        It cannot be deleted if it's used in a news article.
    </div>

    <div class="bg-white p-4 shadow rounded">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Category.CategoryName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Category.CategoryDesciption</dd>

            <dt class="col-sm-3">Parent</dt>
            <dd class="col-sm-9">@Model.Category.ParentCategory?.CategoryName ?? "None"</dd>

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@((Model.Category.IsActive == true) ? "Yes" : "No")</dd>
        </dl>

        <form method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
