@page "{id:int}"
@model NewsManagementSystem.Web.Pages.NewsArticles.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<style>
    .na-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 30px;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
        font-family: 'Segoe UI', sans-serif;
    }

    .na-title {
        font-size: 28px;
        margin-bottom: 10px;
    }

    .na-subtitle {
        font-size: 18px;
        color: #333;
        margin-bottom: 30px;
    }

    .na-info-card {
        padding: 20px 30px;
        background-color: #f8f9fa;
        border-radius: 12px;
        box-shadow: inset 0 0 4px rgba(0,0,0,0.04);
    }

    dt {
        font-weight: 600;
        color: #555;
        margin-top: 12px;
    }

    dd {
        margin-bottom: 16px;
        color: #333;
    }

    .na-info-card ul {
        list-style: disc;
        padding-left: 20px;
        margin: 0;
    }

    .na-info-card li {
        color: #444;
        margin-bottom: 6px;
    }

    .na-btn-delete {
        background-color: #dc3545;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 16px;
        transition: background-color 0.3s ease;
        cursor: pointer;
    }

        .na-btn-delete:hover {
            background-color: #c82333;
        }

    .na-btn-secondary {
        background-color: #6c757d;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: background-color 0.2s ease-in-out;
        margin-left: 10px;
    }

        .na-btn-secondary:hover {
            background-color: #545b62;
        }
    /* Xử lý modal đẹp hơn và chính giữa */
    .custom-modal {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        max-width: 400px;
        margin: auto;
        border-radius: 1rem;
    }

    .modal-header {
        background-color: #dc3545;
        color: white;
        border-bottom: none;
        justify-content: center;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        text-align: center;
    }

        .modal-header .modal-title {
            width: 100%;
            font-size: 1.5rem;
            font-weight: bold;
        }

    .modal-body {
        text-align: center;
        padding: 1.5rem;
    }

        .modal-body p {
            font-size: 1.1rem;
            font-weight: 500;
            margin: -315px;
            color: #333;
        }

    .modal-footer {
        border-top: none;
        justify-content: center;
        gap: 1rem;
        padding-bottom: 1.5rem;
    }

        .modal-footer .btn {
            min-width: 120px;
            font-size: 1rem;
            font-weight: 500;
            padding: 0.5rem 1.5rem;
            border-radius: 0.5rem;
        }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #545b62;
        }
</style>

<div class="na-container">
    <h1 class="na-title text-danger">Delete News Article</h1>
    <h4 class="na-subtitle">Are you sure you want to delete this article?</h4>

    <div class="na-info-card">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.NewsArticle.NewsTitle</dd>

            <dt class="col-sm-4">Headline</dt>
            <dd class="col-sm-8">@Model.NewsArticle.Headline</dd>

            <dt class="col-sm-4">Created Date</dt>
            <dd class="col-sm-8">@Model.NewsArticle.CreatedDate?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">Content</dt>
            <dd class="col-sm-8">@Model.NewsArticle.NewsContent</dd>

            <dt class="col-sm-4">Source</dt>
            <dd class="col-sm-8">@Model.NewsArticle.NewsSource</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (Model.NewsArticle.NewsStatus == true)
                {
                    <span style="color: green; font-weight: bold;">Active</span>
                }
                else
                {
                    <span style="color: red; font-weight: bold;">Inactive</span>
                }
            </dd>

            <dt class="col-sm-4">Modified Date</dt>
            <dd class="col-sm-8">@Model.NewsArticle.ModifiedDate?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Model.NewsArticle.Category?.CategoryDesciption</dd>

            <dt class="col-sm-4">Created By</dt>
            <dd class="col-sm-8">@Model.NewsArticle.CreatedBy?.AccountName</dd>

            <dt class="col-sm-4">Tags</dt>
            <dd class="col-sm-8">
                @if (Model.NewsArticle.Tags != null && Model.NewsArticle.Tags.Any())
                {
                    <ul>
                        @foreach (var tag in Model.NewsArticle.Tags)
                        {
                            <li>@tag.TagName</li>
                        }
                    </ul>
                }
                else
                {
                    <span>No tags available</span>
                }
            </dd>
        </dl>
    </div>

    <form id="deleteForm" id="deleteArticleForm" asp-page="Delete" method="post" class="mt-4 d-flex justify-content-end align-items-center gap-2">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="NewsArticle.NewsArticleId" />
        <p>Are you sure you want to delete <strong>@Model.NewsArticle.NewsTitle</strong>?</p>
        <button type="button" class="na-btn-delete" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">Delete</button>
        <a asp-page="Index" class="na-btn-secondary">Back</a>
    </form>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal rounded-4">
            <div class="modal-header bg-danger text-white justify-content-center border-0 rounded-top-4 py-4">
                <h5 class="modal-title fw-bold text-center m-0" id="confirmDeleteModalLabel">Confirm Delete</h5>
            </div>
            <div class="modal-body text-center py-3 px-4">
                <p class="fs-5 fw-medium text-dark mb-0">Are you sure you want to delete this article?</p>
            </div>
            <div class="modal-footer justify-content-center gap-3 border-0 pb-4">
                <button type="button" class="btn btn-secondary px-4 py-2 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="deleteForm" class="btn btn-danger px-4 py-2 rounded-3">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/dataHub")
            .build();

        connection.start().catch(err => console.error(err.toString()));

        document.getElementById("deleteForm").addEventListener("submit", function () {
            const title = "@Model.NewsArticle.NewsTitle";
            connection.invoke("SendToAll", "ArticleDeleted", title)
                .catch(err => console.error(err.toString()));
        });
    </script>
}
