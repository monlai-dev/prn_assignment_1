@page
@model NewsManagementSystem.Web.Pages.Account.LoginRegisterModel
@{
    Layout = null;
    var messageError = TempData["LOGIN_ERROR"] as string;
    TempData.Remove("LOGIN_ERROR");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Login.css" />
    <title>Login/Register Page</title>
</head>
<body>
    @if (!string.IsNullOrEmpty(messageError))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                alert("@Html.Raw(messageError)");
            });
        </script>
    }

    <button id="btnBack" onclick="location.href='/'">&#8592; Trở lại</button>

    <div class="container" id="container">
        <!-- REGISTER -->
        <div class="form-container sign-up">
            <form method="post" asp-page-handler="Register">
                <h1>Tạo tài khoản</h1>
                <div class="social-icons">
                    <a asp-page-handler="LoginGoogle" class="icon">
                        <i class="fa-brands fa-google-plus-g"></i>
                    </a>
                </div>
                <span>Hoặc sử dụng email để đăng ký</span>

                <input asp-for="Register.RegisterName" placeholder="Tên đầy đủ" required />
                <span asp-validation-for="Register.RegisterName" class="text-danger"></span>

                <input asp-for="Register.RegisterEmail" placeholder="Email" required />
                <span asp-validation-for="Register.RegisterEmail" class="text-danger"></span>

                <input asp-for="Register.RegisterPassword" type="password" placeholder="Mật khẩu" required />
                <span asp-validation-for="Register.RegisterPassword" class="text-danger"></span>

                <input asp-for="Register.ConfirmPassword" type="password" placeholder="Xác nhận mật khẩu" required />
                <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>

                <button type="submit">Đăng Ký</button>
                @if (!string.IsNullOrEmpty(messageError))
                {
                    <span style="color:red; font-size:14px;">@messageError</span>
                }
            </form>
        </div>

        <!-- LOGIN -->
        <div class="form-container sign-in">
            <form method="post" asp-page-handler="Login">
                <h1>Đăng nhập</h1>
                <div class="social-icons">
                    <a asp-page-handler="LoginGoogle" class="icon">
                        <i class="fa-brands fa-google-plus-g"></i>
                    </a>
                </div>
                <span>Hoặc sử dụng Email và Password</span>

                <input asp-for="Login.LoginEmail" placeholder="Email" required />
                <span asp-validation-for="Login.LoginEmail" class="text-danger"></span>

                <input asp-for="Login.LoginPassword" type="password" placeholder="Mật khẩu" required />
                <span asp-validation-for="Login.LoginPassword" class="text-danger"></span>

                <a asp-page="ForgotPassword">Quên mật khẩu?</a>
                <button type="submit">Đăng Nhập</button>

                @if (!string.IsNullOrEmpty(messageError))
                {
                    <span style="color:red; font-size:14px;">@messageError</span>
                }
            </form>
        </div>

        <!-- TOGGLE -->
        <div class="toggle-container">
            <div class="toggle">
                <div class="toggle-panel toggle-left">
                    <h1>Chào mừng trở lại!</h1>
                    <p>Nhập thông tin cá nhân của bạn để sử dụng tất cả tính năng</p>
                    <button id="login">Đăng nhập</button>
                </div>
                <div class="toggle-panel toggle-right">
                    <h1>Chào, bạn!</h1>
                    <p>Đăng ký thông tin cá nhân để sử dụng tất cả tính năng</p>
                    <button id="register">Đăng ký</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/Login.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
           var showRegister = '@(ViewData["ShowRegister"] ?? false)'.toLowerCase();
            if (showRegister === 'true') {
                document.getElementById("container").classList.add("active");
            }
        });
    </script>
</body>
</html>
