@page
@model NewsManagementSystem.Web.Pages.Admin.UserModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "User Management";
    var user = ViewData["UserInfo"] as NewsManagementSystem.BusinessObject.Configuration.LoginDTO;
}

<style>
    .modal, .model h5 {
        color: #212529;
    }
</style>

<div class="container mt-4">
    <h2>User Management</h2>
    <div class="d-flex justify-content-between mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            + Create User
        </button>
        <a asp-page="/Article/StatisticsByPeriod"
           class="btn btn-outline-info">
            📊 View Article&nbsp;Stats
        </a>
    </div>
    <table class="table table-bordered" id="userTable">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="userTableBody">
            @foreach (var user1 in Model.Users.Items)
            {
                <tr data-id="@user1.AccountId">
                    <td>@user1.AccountName</td>
                    <td>@user1.AccountEmail</td>
                    <td>@user1.AccountRole</td>
                    <td>
                        <button class="btn btn-sm btn-success me-1" onclick="openEditModal(@user1.AccountId)">Edit</button>
                        <button class="btn btn-sm btn-danger" onclick="openDeleteModal(@user1.AccountId, '@user1.AccountName')">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" id="createForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">Create User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountName" class="form-label"></label>
                        <input asp-for="UserInput.AccountName" class="form-control" />
                        <span asp-validation-for="UserInput.AccountName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountEmail" class="form-label"></label>
                        <input asp-for="UserInput.AccountEmail" class="form-control" />
                        <span asp-validation-for="UserInput.AccountEmail" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountRole" class="form-label"></label>
                        <input asp-for="UserInput.AccountRole" class="form-control" />
                        <span asp-validation-for="UserInput.AccountRole" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountPassword" class="form-label"></label>
                        <input asp-for="UserInput.AccountPassword" class="form-control" type="password" />
                        <span asp-validation-for="UserInput.AccountPassword" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" id="editForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="UserInput.AccountId" id="editUserId" />
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountName" class="form-label"></label>
                        <input asp-for="UserInput.AccountName" class="form-control" id="editUserName" />
                        <span asp-validation-for="UserInput.AccountName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountEmail" class="form-label"></label>
                        <input asp-for="UserInput.AccountEmail" class="form-control" id="editUserEmail" />
                        <span asp-validation-for="UserInput.AccountEmail" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountRole" class="form-label"></label>
                        <input asp-for="UserInput.AccountRole" class="form-control" id="editUserRole" />
                        <span asp-validation-for="UserInput.AccountRole" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="UserInput.AccountPassword" class="form-label"></label>
                        <input asp-for="UserInput.AccountPassword" class="form-control" id="editUserPassword" type="password" />
                        <span asp-validation-for="UserInput.AccountPassword" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete" id="deleteForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Delete User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="DeleteUserId" id="deleteUserId" />
                    <p>Are you sure you want to delete <strong id="deleteUserName"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/user.js"></script>
}