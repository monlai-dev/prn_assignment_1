@page
@model NewsManagementSystem.Web.Pages.Tag.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tag List";
}
<h1>Tag List</h1>

<p>
    <button class="btn btn-primary" onclick="openCreateModal()">Create New Tag</button>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Tag[0].TagName)</th>
            <th>@Html.DisplayNameFor(model => model.Tag[0].Note)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="tag-table-body">
        @foreach (var item in Model.Tag)
        {
            <tr data-tag-id="@item.TagId">
                <td>@item.TagName</td>
                <td>@item.Note</td>
                <td>
                    <a href="javascript:void(0);" onclick="openEditModal('@item.TagId')">Edit</a> |
                    <a href="javascript:void(0);" onclick="confirmDelete('@item.TagId')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- CREATE MODAL -->
<div id="createModal" class="modal" tabindex="-1" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Tag</h5>
                <button type="button" class="btn-close" onclick="closeCreateModal()"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_CreatePartial", new NewsManagementSystem.BusinessObject.Models.Tag())
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div id="editModal" class="modal" tabindex="-1" style="display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="Edit_TagId" name="TagId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Tag</h5>
                    <button type="button" class="btn-close" onclick="closeEditModal()"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Edit_TagName" class="form-label">Tag Name</label>
                        <input type="text" class="form-control" id="Edit_TagName" name="TagName" required />
                    </div>
                    <div class="mb-3">
                        <label for="Edit_Note" class="form-label">Note</label>
                        <input type="text" class="form-control" id="Edit_Note" name="Note" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createModal = document.getElementById('createModal');
        const createForm = document.getElementById('createForm');
        const editModal = document.getElementById('editModal');
        const editForm = document.getElementById('editForm');
        const tableBody = document.getElementById('tag-table-body');

        function openCreateModal() {
            createModal.style.display = 'block';
            createModal.classList.add('show');
            document.body.classList.add('modal-open');
        }

        function closeCreateModal() {
            createModal.classList.remove('show');
            createModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            createForm?.reset();
            document.querySelectorAll('.text-danger').forEach(span => span.textContent = '');
        }

        createForm?.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(createForm);
            const token = createForm.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/Tag/Create', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.createElement('tr');
                    row.setAttribute('data-tag-id', data.tagId);
                    row.innerHTML = `
                        <td>${data.tagName}</td>
                        <td>${data.note ?? ''}</td>
                        <td>
                            <a href="javascript:void(0);" onclick="openEditModal('${data.tagId}')">Edit</a> |
                            <a href="javascript:void(0);" onclick="confirmDelete('${data.tagId}')">Delete</a>
                        </td>
                    `;
                    tableBody.appendChild(row);
                    closeCreateModal();
                } else if (data.errors) {
                    for (const field in data.errors) {
                        const span = document.querySelector(`[data-valmsg-for="${field}"]`);
                        if (span) span.textContent = data.errors[field][0];
                    }
                } else {
                    alert('Error creating tag.');
                }
            })
            .catch(err => alert('Failed to create tag.'));
        });

        function openEditModal(tagId) {
            fetch(`/Tag/Edit?id=${tagId}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('Edit_TagId').value = data.tagId;
                    document.getElementById('Edit_TagName').value = data.tagName;
                    document.getElementById('Edit_Note').value = data.note || '';

                    editModal.style.display = 'block';
                    editModal.classList.add('show');
                    document.body.classList.add('modal-open');
                });
        }

        function closeEditModal() {
            editModal.classList.remove('show');
            editModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            editForm.reset();
        }

        editForm?.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(editForm);
            const token = editForm.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/Tag/Edit', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(res => {
                if (!res.ok) throw new Error("Request failed");
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    const row = document.querySelector(`[data-tag-id="${data.tagId}"]`);
                    if (row) {
                        row.children[0].textContent = data.tagName;
                        row.children[1].textContent = data.note || '';
                    }
                    closeEditModal();
                } else {
                    alert('Failed to update tag.');
                }
            })
            .catch(err => alert('Error updating tag.'));
        });

               function confirmDelete(tagId) {
            if (confirm("Are you sure you want to delete this tag?")) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append("id", tagId);
                formData.append("__RequestVerificationToken", token);

                fetch('/Tag/Delete', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const row = document.querySelector(`[data-tag-id="${tagId}"]`);
                        if (row) row.remove();
                    } else {
                        alert("Delete failed.");
                    }
                })
                .catch(() => alert("Delete error."));
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}
