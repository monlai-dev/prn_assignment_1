@page
@model NewsManagementSystem.Web.Pages.Tag.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tag List";
    Layout = "_LayoutStaff";
    var user = ViewData["UserInfo"] as NewsManagementSystem.BusinessObject.Configuration.LoginDTO;
}
<h1 class="page-title" style="color:brown">📌 Tag List</h1>

<p>
    <button class="btn btn-primary" onclick="openCreateModal()">➕ Create New Tag</button>
</p>

<table class="tag-table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Tag[0].TagName)</th>
            <th>@Html.DisplayNameFor(model => model.Tag[0].Note)</th>
            <th style="width: 140px;">Actions</th>
        </tr>
    </thead>
    <tbody id="tag-table-body">
        @foreach (var item in Model.Tag)
        {
            <tr data-tag-id="@item.TagId">
                <td>@item.TagName</td>
                <td>@item.Note</td>
                <td>
                    <a href="javascript:void(0);" onclick="openEditModal('@item.TagId')">✏️ Edit</a> |
                    <a href="javascript:void(0);" onclick="confirmDelete('@item.TagId')">🗑️ Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #f0f8ff;
        margin: 0;
        padding: 0;
    }

    .tag-container {
        max-width: 1000px;
        margin: 40px auto;
        padding: 30px 40px;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
    }

    .tag-title {
        text-align: center;
        font-size: 30px;
        font-weight: 600;
        color: #007acc;
        margin-bottom: 30px;
    }

    .tag-action-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
    }

    .tag-btn-create {
        background-color: #007acc;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
        transition: 0.3s ease;
    }

        .tag-btn-create:hover {
            background-color: #005fa3;
            transform: translateY(-1px);
        }

    .tag-table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 12px;
        overflow: hidden;
    }

        .tag-table thead {
            background-color: #007acc;
            color: white;
            font-size: 16px;
        }

        .tag-table th,
        .tag-table td {
            padding: 16px 20px;
            text-align: left;
        }

        .tag-table tbody tr {
            border-bottom: 1px solid #e0e0e0;
            transition: background 0.2s ease;
        }

            .tag-table tbody tr:hover {
                background-color: #f1f9ff;
            }

    .tag-btn-action {
        padding: 8px 14px;
        margin: 0 3px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9em;
        font-weight: 500;
        display: inline-block;
        transition: all 0.2s ease;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    }

        .tag-btn-action.edit {
            background-color: #28a745;
            color: white;
        }

        .tag-btn-action.details {
            background-color: #17a2b8;
            color: white;
        }

        .tag-btn-action.delete {
            background-color: #dc3545;
            color: white;
        }

        .tag-btn-action:hover {
            opacity: 0.95;
            transform: scale(1.05);
        }

    .tag-table td {
        color: #333333;
    }

    .custom-create-modal {
        max-width: 500px;
        margin: auto;
        border-radius: 1rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .modal-title {
        font-size: 1.4rem;
    }

    .modal-body {
        padding-top: 0;
    }

    .btn-close {
        background-color: transparent;
        border: none;
        font-size: 1.2rem;
    }

    .custom-edit-modal {
        max-width: 500px;
        margin: auto;
        border-radius: 1rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .modal-title {
        font-size: 1.4rem;
    }

    .modal-body {
        padding-top: 0;
    }

        .modal-body .form-label {
            font-size: 1rem;
            margin-bottom: 4px;
        }

    .form-control {
        font-size: 1rem;
        padding: 10px 14px;
    }

    .btn {
        min-width: 120px;
        font-weight: 500;
        font-size: 1rem;
    }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #545b62;
        }

    .btn-close {
        background: transparent;
    }

</style>

<!-- CREATE MODAL -->
<div id="createModal" class="modal fade" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow custom-create-modal">
            <div class="modal-header justify-content-center border-0 bg-white rounded-top-4">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" onclick="closeCreateModal()" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                @await Html.PartialAsync("_CreatePartial", new NewsManagementSystem.BusinessObject.Models.Tag())
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div id="editModal" class="modal fade" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow custom-edit-modal">
            <form id="editForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="Edit_TagId" name="TagId" />

                <div class="modal-header justify-content-center border-0 bg-white rounded-top-4">
                    <h5 class="modal-title text-primary fw-bold text-center" id="editModalLabel">Edit Tag</h5>
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" onclick="closeEditModal()" aria-label="Close"></button>
                </div>

                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label for="Edit_TagName" class="form-label fw-semibold text-dark">Tag Name</label>
                        <input type="text" class="form-control rounded-3" id="Edit_TagName" name="TagName" required />
                    </div>
                    <div class="mb-3">
                        <label for="Edit_Note" class="form-label fw-semibold text-dark">Note</label>
                        <input type="text" class="form-control rounded-3" id="Edit_Note" name="Note" />
                    </div>
                </div>

                <div class="modal-footer justify-content-center gap-3 border-0 pb-4">
                    <button type="button" class="btn btn-secondary px-4 py-2 rounded-3" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        const createModal = document.getElementById('createModal');
        const createForm = document.getElementById('createForm');
        const editModal = document.getElementById('editModal');
        const editForm = document.getElementById('editForm');
        const tableBody = document.getElementById('tag-table-body');

        function openCreateModal() {
            createModal.style.display = 'block';
            createModal.classList.add('show');
            document.body.classList.add('modal-open');
        }

        function closeCreateModal() {
            createModal.classList.remove('show');
            createModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            createForm?.reset();
            document.querySelectorAll('.text-danger').forEach(span => span.textContent = '');
        }

        createForm?.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(createForm);
            const token = createForm.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/Tag/Create', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const row = document.createElement('tr');
                    row.setAttribute('data-tag-id', data.tagId);
                    row.innerHTML = `
                        <td>${data.tagName}</td>
                        <td>${data.note ?? ''}</td>
                        <td>
                            <a href="javascript:void(0);" onclick="openEditModal('${data.tagId}')">Edit</a> |
                            <a href="javascript:void(0);" onclick="confirmDelete('${data.tagId}')">Delete</a>
                        </td>
                    `;
                    tableBody.appendChild(row);
                    closeCreateModal();
                } else if (data.errors) {
                    for (const field in data.errors) {
                        const span = document.querySelector(`[data-valmsg-for="${field}"]`);
                        if (span) span.textContent = data.errors[field][0];
                    }
                } else {
                    alert('Error creating tag.');
                }
            })
            .catch(err => alert('Failed to create tag.'));
        });

        function openEditModal(tagId) {
            fetch(`/Tag/Edit?id=${tagId}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('Edit_TagId').value = data.tagId;
                    document.getElementById('Edit_TagName').value = data.tagName;
                    document.getElementById('Edit_Note').value = data.note || '';

                    editModal.style.display = 'block';
                    editModal.classList.add('show');
                    document.body.classList.add('modal-open');
                });
        }

        function closeEditModal() {
            editModal.classList.remove('show');
            editModal.style.display = 'none';
            document.body.classList.remove('modal-open');
            editForm.reset();
        }

        editForm?.addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(editForm);
            const token = editForm.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/Tag/Edit', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(res => {
                if (!res.ok) throw new Error("Request failed");
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    const row = document.querySelector(`[data-tag-id="${data.tagId}"]`);
                    if (row) {
                        row.children[0].textContent = data.tagName;
                        row.children[1].textContent = data.note || '';
                    }
                    closeEditModal();
                } else {
                    alert('Failed to update tag.');
                }
            })
            .catch(err => alert('Error updating tag.'));
        });

               function confirmDelete(tagId) {
            if (confirm("Are you sure you want to delete this tag?")) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append("id", tagId);
                formData.append("__RequestVerificationToken", token);

                fetch('/Tag/Delete', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const row = document.querySelector(`[data-tag-id="${tagId}"]`);
                        if (row) row.remove();
                    } else {
                        alert("Delete failed.");
                    }
                })
                .catch(() => alert("Delete error."));
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
}


